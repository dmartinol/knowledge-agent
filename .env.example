# Knowledge Search Agent configuration (APPENG-7054).
# Copy to .env for local runs; .env is git-ignored.
# Start with: uv run --env-file .env knowledge-agent

# Bind address of this A2A service.
HOST=127.0.0.1
PORT=8081

# Base URL advertised in the Agent Card. Defaults to http://$HOST:$PORT.
# PUBLIC_URL=http://127.0.0.1:8081

# LCORE Agent Card used by the upstream A2A client (APPENG-7055).
LCORE_AGENT_CARD_URL=http://localhost:8080/.well-known/agent-card.json

# Bounded workflow limits. Parsed and validated here; enforced by APPENG-7056.
WORKFLOW_MAX_ROUNDS=2
WORKFLOW_UPSTREAM_TIMEOUT_SECONDS=90
WORKFLOW_TASK_DEADLINE_SECONDS=180
WORKFLOW_MAX_CONCURRENT_TASKS=4
