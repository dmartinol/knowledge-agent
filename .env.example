# Knowledge Search Agent configuration.
# Copy to .env for local runs; .env is git-ignored.
# Start with: uv run --env-file .env knowledge-agent

# Bind address of this A2A service.
HOST=127.0.0.1
PORT=8081

# Base URL advertised in the Agent Card. Defaults to http://$HOST:$PORT.
# PUBLIC_URL=http://127.0.0.1:8081

# LCORE Agent Card used by the upstream A2A client.
LCORE_AGENT_CARD_URL=http://localhost:8080/.well-known/agent-card.json

# Agent-owned reasoning model (OpenAI-compatible).
# AGENT_LLM_BASE_URL falls back to OPENAI_BASE_URL.
# AGENT_LLM_MODEL falls back to E2E_OPENAI_MODEL.
# AGENT_LLM_API_KEY falls back to OPENAI_API_KEY.
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_REQUEST_LIMIT=6
AGENT_LLM_TOTAL_TOKENS_LIMIT=60000

# Directory holding the SKILL.md packages loaded into the agent at startup.
# Not shipped in the wheel: a deployment must mount it and point this here.
AGENT_SKILLS_DIR=skills

# Bounded workflow limits. The per-call timeout is enforced by the LCORE client.
# WORKFLOW_MAX_ROUNDS is the maximum number of LCORE searches; use 1 to disable
# the follow-up search.
WORKFLOW_MAX_ROUNDS=2
# Maximum characters of LCORE material handed to the reasoning model per search.
WORKFLOW_MAX_MATERIAL_CHARS=12000
WORKFLOW_UPSTREAM_TIMEOUT_SECONDS=90
WORKFLOW_TASK_DEADLINE_SECONDS=180
WORKFLOW_MAX_CONCURRENT_TASKS=4
