# Create this Secret in the target namespace before installing the chart:
#   oc apply -f demo/chart/knowledge-agent/values-secret.yaml.example
# Then install with:
#   helm install knowledge-agent demo/chart/knowledge-agent \
#     --set secrets.existingSecret=knowledge-agent-secrets \
#     --set agent.llm.baseUrl=https://<model-endpoint>/v1 \
#     --set agent.llm.model=<model-name>
apiVersion: v1
kind: Secret
metadata:
  name: knowledge-agent-secrets
type: Opaque
stringData:
  # Agent reasoning model credential.
  AGENT_LLM_API_KEY: ""
  # LCORE inference credential and endpoint.
  OPENAI_API_KEY: ""
  OPENAI_BASE_URL: "https://your-model-endpoint.example/v1"
  # RHOKP (Solr) base URL reachable from the LCORE pod. Used only when
  # rhokp.publicUrl is empty; the chart prefers the public URL when it is set.
  RH_SERVER_OKP: "http://rhokp.rhokp.svc.cluster.local:8080"
